# GA4 measurement ID (Admin → Data streams). Leave the placeholder until it is issued.
# Analytics is not loaded while this value is G-XXXXXXXXXX. Redeploy after changing it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Search Console HTML-tag method: paste only the content value, not the whole meta tag.
# Redeploy after changing it. The placeholder will not verify the property.
GOOGLE_SITE_VERIFICATION=REPLACE_WITH_SEARCH_CONSOLE_VERIFICATION_CODE

# Contact form email through the Hostinger mailbox (hPanel → Emails → Configuration settings).
# SMTP_USER is the full mailbox address and is also the From address. Never commit real values.
# CONTACT_TO_EMAIL is where inquiries land; it defaults to aradhana@aileadvision.com.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=

# Optional fallback when SMTP is not set: an endpoint that accepts the inquiry as JSON.
CONTACT_WEBHOOK_URL=

# Neon Postgres. DATABASE_URL is the pooled app connection. Migrations use the direct URL.
# `neon link` writes these into .env.local. Never commit real values.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Signs the admin session cookie. Use a random string of at least 32 characters.
AUTH_SECRET=

# First admin, created by `npm run db:seed`. The password is hashed before it is stored.
# Re-running the seed does not change an admin that already exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
